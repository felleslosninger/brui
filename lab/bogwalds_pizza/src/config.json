{
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "addPizza",
        "description": "Add a pizza to the order",
        "parameters": {
          "type": "object",
          "properties": {
            "pizzaName": {
              "type": "string",
              "description": "Name of the pizza to add",
              "enum": ["1. Pasta Bolognese", "2. Pasta Bolognese without bacon", "3. Pasta Bolognese without pasta"]
            }
          },
          "required": ["pizzaName"]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "changeActiveTab",
        "description": "Change tab to the given tab name. Home is the home page, welcoming the user. Menu is the menu page, showing the food options. Order is the order page, showing the current order and allowing to fill the order form.",
        "parameters": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "description": "Name of the tab to switch to",
              "enum": ["home", "menu", "order"]
            }
          },
          "required": ["value"]
        }
      }
    },
      {
          "type": "function",
          "function": {
              "name": "fillForm",
              "description": "Fill the order form with given args",
              "parameters": {
                  "type": "object",
                  "properties": {
                      "name": {
                          "type": "string",
                          "description": "Name of the customer"
                      },
                      "table": {
                          "type": "string",
                          "description": "Table number"
                      },
                      "orderNumber": {
                          "type": "string",
                          "description": "Order number",
                          "enum": ["1. Pasta Bolognese", "2. Pasta Bolognese without bacon", "3. Pasta Bolognese without pasta"]
                      }
                  },
                  "required": ["name", "table", "orderNumber"]
              }
          }
      }
  ],
  "actions": [
    {
      "name": "addPizzaToOrder",
      "type": "function",
      "args": [],
      "message": "Added pizza to the order."
    },
    {
      "name": "handleSetActiveTab",
      "type": "function",
      "args": ["value"],
      "message": "Changed active tab to {value}"
    },
    {
      "name": "fillFields",
      "type": "function",
      "args": ["name", "table", "orderNumber"],
      "message": "Updated order form with name: {name}, table: {table}, order number: {orderNumber}"
    }
  ],
  "decisions": [
    { "tool": "changeActiveTab", "actions": ["handleSetActiveTab"] },
    { "tool": "addPizza", "actions": ["addPizzaToOrder"] },
    { "tool": "fillForm", "actions": ["fillFields"] }
  ],
  "inference": {
    "kind": "inference",
    "name": "default",
    "spec": {
      "name": "envoy-default"
    }
  }
}
