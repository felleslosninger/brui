{
  "name": "@digdir/brui-ui",
  "version": "0.1.1",
  "description": "React sidebar component for LLM-driven chat interaction",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
